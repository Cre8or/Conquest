#define MACRO_FNC_FADECTRL_FILL(VARNAME_CONTROL, VARNAME_COLOUR, VARNAME_ORIGINALALPHA, VARNAME_FADE) \
	VARNAME_COLOUR        = ctrlBackgroundColor VARNAME_CONTROL; \
	VARNAME_ORIGINALALPHA = VARNAME_CONTROL getVariable [QGVAR(macro_fnc_fadeCtrl_alpha), -1]; \
	if (VARNAME_ORIGINALALPHA < 0) then { \
		VARNAME_ORIGINALALPHA = VARNAME_COLOUR select 3; \
		VARNAME_CONTROL setVariable [QGVAR(macro_fnc_fadeCtrl_alpha), VARNAME_ORIGINALALPHA]; \
	}; \
	VARNAME_COLOUR set [3, VARNAME_ORIGINALALPHA * VARNAME_FADE]; \
	VARNAME_CONTROL ctrlSetBackgroundColor VARNAME_COLOUR;

#define MACRO_FNC_FADECTRL_TEXT(VARNAME_CONTROL, VARNAME_COLOUR, VARNAME_ORIGINALALPHA, VARNAME_FADE) \
	VARNAME_COLOUR        = ctrlTextColor VARNAME_CONTROL; \
	VARNAME_ORIGINALALPHA = VARNAME_CONTROL getVariable [QGVAR(macro_fnc_fadeCtrl_alpha), -1]; \
	if (VARNAME_ORIGINALALPHA < 0) then { \
		VARNAME_ORIGINALALPHA = VARNAME_COLOUR select 3; \
		VARNAME_CONTROL setVariable [QGVAR(macro_fnc_fadeCtrl_alpha), VARNAME_ORIGINALALPHA]; \
	}; \
	VARNAME_COLOUR set [3, VARNAME_ORIGINALALPHA * VARNAME_FADE]; \
	VARNAME_COLOUR set [3, (VARNAME_COLOUR select 3) * VARNAME_FADE]; \
	VARNAME_CONTROL ctrlSetTextColor VARNAME_COLOUR
